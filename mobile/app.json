{
  "expo": {
    "name": "Alo Çukur Hattı",
    "slug": "alocukurhatti",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF9F4"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1FA98B"
      },
      "package": "com.talha.alocukurhatti",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.talha.alocukurhatti",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Sorunun konumunu otomatik tespit etmek için konum iznine ihtiyacımız var.",
        "NSCameraUsageDescription": "Sorunun fotoğrafını çekmek için kamera iznine ihtiyacımız var.",
        "NSPhotoLibraryUsageDescription": "Galeriden fotoğraf seçmek için izin gerekiyor."
      }
    },
    "plugins": [
      "expo-location",
      "expo-image-picker",
      "expo-camera",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "9e16af7f-5e95-4abe-8a41-bd5671e7640a"
      }
    },
    "owner": "talha1yilmaz"
  }
}
