{
  "expo": {
    "name": "Alo Çukur Hattı",
    "slug": "alocukurhatti",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF9F4"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1FA98B"
      },
      "package": "com.talha.alocukurhatti",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.talha.alocukurhatti",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Sorunun konumunu otomatik tespit etmek için konum iznine ihtiyacımız var.",
        "NSCameraUsageDescription": "Sorunun fotoğrafını çekmek için kamera iznine ihtiyacımız var.",
        "NSPhotoLibraryUsageDescription": "Galeriden fotoğraf seçmek için izin gerekiyor."
      }
    },
    "extra": {
      "eas": {
        "projectId": "BURAYA-EAS-PROJECT-ID-YAZILACAK"
      }
    },
    "plugins": [
      "expo-location",
      "expo-image-picker",
      "expo-camera",
      "expo-font"
    ]
  }
}
